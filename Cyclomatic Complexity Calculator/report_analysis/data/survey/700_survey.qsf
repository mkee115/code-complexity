"10\" cellspacing=\"0\" style=\"width:1040px;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"text-align:center; font-family:Arial,Helvetica,sans-serif; font-size:16px;\"><strong>Method A<\/strong><\/td>\n\t\t\t<td style=\"text-align:center; font-family:Arial,Helvetica,sans-serif; font-size:16px;\"><strong>Method B<\/strong><\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align:center;\"><img alt=\"\" src=\"https:\/\/github.com\/mkee115\/code-complexity\/blob\/feat\/cognitive-complexity\/survey_methods\/01-ORIG.png?raw=true\" style=\"width:720px; height:auto;\"><\/td>\n\t\t\t<td style=\"text-align:center;\"><img alt=\"\" src=\"https:\/\/github.com\/mkee115\/code-complexity\/blob\/feat\/cognitive-complexity\/survey_methods\/01-V4.png?raw=true\" style=\"width:720px; height:auto;\"><\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>","DataExportTag":"Q1Ci","QuestionID":"QID26"}},{"SurveyID":"SV_4ShWaSBni7jDt4y","Element":"SQ","PrimaryAttribute":"QID27","SecondaryAttribute":"Explain very briefly what the code does","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Explain very briefly what the code does<\/h2>","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Explain very briefly what the code does","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"<h2>Explain very briefly what the code does<\/h2>","DataExportTag":"Q1Cii","QuestionID":"QID27"}},{"SurveyID":"SV_4ShWaSBni7jDt4y","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":"(Optional) What made one method feel easier or harder to read? (e.g. structure, naming, length)","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>(Optional) What made one method feel easier or harder to read? (e.g. structure, naming, length)<\/h2>","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"(Optional) What made one method feel easier or harder to read? (e.g. structure, naming, length)","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"<h2>(Optional) What made one method feel easier or harder to read? (e.g. structure, naming, length)<\/h2>","DataExportTag":"Q1Ciii","QuestionID":"QID28"}},{"SurveyID":"SV_4ShWaSBni7jDt4y","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Welcome and thank you for participating! This survey is part of a University of Auckland Part IV...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:22px;\">Welcome and thank you for participating! This survey is part of a University of Auckland Part IV research project on software complexity metrics.<br>\n<br>\nYou will be shown pairs of Java methods and asked to judge which is easier to understand, and by how much.<br>\n<br>\n<strong>There are no right or wrong answers. <\/strong>We are interested in your genuine first impression.<\/span><\/p><p><span style=\"font-size:22px;\"><br><\/span><\/p><p><span style=\"font-size:22px;\">You will not be able to go back to a previous question.<\/span><\/p>","DefaultChoices":false,"DataExportTag":"Introduction","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome and thank you for participating! This survey is part of a University of Auckland Part IV...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_4ShWaSBni7jDt4y","Element":"SQ","PrimaryAttribute":"QID30","SecondaryAttribute":"What is the output of this code snippet? int n = 72; String grade = n = 90 ? \"A\" : n = 80 ? \"B\" :...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>What is the output of this code snippet?<\/p>\n<div style=\"background:#f4f4f4; border:1px solid #ddd; border-radius:4px; padding:12px 16px; font-family:Consolas, 'Courier New', monospace; font-size:14px; line-height:1.6;\">\nint n = 72;<br>\nString grade = n &gt;= 90 ? \"A\" : n &gt;= 80 ? \"B\" : n &gt;= 70 ? \"C\" : \"D\";<br>\nSystem.out.println(grade);\n<\/div>","DefaultChoices":false,"DataExportTag":"Java Q1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is the output of this code snippet? int n = 72; String grade = n = 90 ? \"A\" : n = 80 ? \"B\" :...","Choices":{"1":{"Display":"A"},"2":{"Display":"B"},"3":{"Display":"C"},"4":{"Display":"D"},"5":{"Display":"Error"},"6":{"Display":"Unsure"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID30"}},{"SurveyID":"SV_4ShWaSBni7jDt4y","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"What is the output of this code snippet? int result = 17 % 5; System.out.println(result);","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>What is the output of this code snippet?<\/p>\n<div style=\"background:#f4f4f4; border:1px solid #ddd; border-radius:4px; padding:12px 16px; font-family:Consolas, 'Courier New', monospace; font-size:14px; line-height:1.6;\">\nint result = 17 % 5;<br>\nSystem.out.println(result);\n<\/div>","DataExportTag":"Java Q2","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is the output of this code snippet? int result = 17 % 5; System.out.println(result);","Choices":{"1":{"Display":"2"},"2":{"Display":"3"},"3":{"Display":"3.4"},"4":{"Display":"4"},"5":{"Display":"12"},"6":{"Display":"22"},"7":{"Display":"Error"},"8":{"Display":"Unsure"}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID31"}},{"SurveyID":"SV_4ShWaSBni7jDt4y","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"What is the output of this code snippet? static int mystery(int n) { \u00a0\u00a0\u00a0\u00a0if (n = 1) { \u00a0\u00a0\u00a0\u00a0\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>What is the output of this code snippet?<\/p>\n<div style=\"background:#f4f4f4; border:1px solid #ddd; border-radius:4px; padding:12px 16px; font-family:Consolas, 'Courier New', monospace; font-size:14px; line-height:1.6;\">\nstatic int mystery(int n) {<br>\n&nbsp;&nbsp;&nbsp;&nbsp;if (n &lt;= 1) {<br>\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return 1;<br>\n&nbsp;&nbsp;&nbsp;&nbsp;}<br>\n&nbsp;&nbsp;&nbsp;&nbsp;return n * mystery(n - 1);<br>\n}<br>\nSystem.out.println(mystery(4));\n<\/div>","DataExportTag":"Java Q3","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is the output of this code snippet? static int mystery(int n) { \u00a0\u00a0\u00a0\u00a0if (n = 1) { \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0ret...","Choices":{"1":{"Display":"1"},"2":{"Display":"4"},"3":{"Display":"10"},"4":{"Display":"24"},"5":{"Display":"Infinite Recursion"},"6":{"Display":"Error"},"7":{"Display":"Unsure"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"